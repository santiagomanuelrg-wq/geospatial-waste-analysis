{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOZQiYn0nqf57oiL5W3H1gu"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["# 0. Limpieza de los datos obtenidos de la pagina del municipio\n"],"metadata":{"id":"aoj1ZOKnQtYs"}},{"cell_type":"code","source":["import json\n","import pandas as pd\n","\n","# === 1. CARGAR EL JSON (arreglando la llave faltante) ===\n","with open('datos_powerbi.json', 'r', encoding='utf-8-sig') as f:\n","    contenido = f.read()\n","\n","# Agregar llave de apertura si falta\n","if not contenido.lstrip().startswith('{'):\n","    contenido = '{' + contenido\n","\n","data = json.loads(contenido)\n","print(\"✅ JSON cargado correctamente\")\n","\n","# === 2. EXTRAER LOS PUNTOS ===\n","puntos = []\n","estado_actual = None\n","\n","def extraer(nodo):\n","    global estado_actual\n","    if isinstance(nodo, dict):\n","        # Actualizar estado si aparece G0\n","        if 'G0' in nodo:\n","            estado_actual = nodo['G0']\n","\n","        # Extraer coordenadas si hay 'C' con 2 valores\n","        if 'C' in nodo and isinstance(nodo['C'], list) and len(nodo['C']) == 2:\n","            lon, lat = nodo['C']\n","            if lon is not None and lat is not None:\n","                puntos.append({\n","                    'Estado': estado_actual,\n","                    'Longitud': float(lon),\n","                    'Latitud': float(lat)\n","                })\n","\n","        for v in nodo.values():\n","            extraer(v)\n","    elif isinstance(nodo, list):\n","        for item in nodo:\n","            extraer(item)\n","\n","extraer(data)\n","df = pd.DataFrame(puntos)\n","print(f\"✅ Se extrajeron {len(df)} puntos\")\n","print(df.head())\n","print(df.tail())\n","\n","# === 3. VERIFICAR QUE SEAN 243 ===\n","if len(df) != 243:\n","    print(f\"⚠️  Se esperaban 243 puntos, se obtuvieron {len(df)}\")\n","else:\n","    print(\"🎯 ¡Perfecto! Se obtuvieron los 243 puntos esperados\")\n","\n","# === 4. GENERAR GEOJSON (sin dependencias extra) ===\n","geojson = {\n","    \"type\": \"FeatureCollection\",\n","    \"features\": [\n","        {\n","            \"type\": \"Feature\",\n","            \"geometry\": {\n","                \"type\": \"Point\",\n","                \"coordinates\": [row['Longitud'], row['Latitud']]\n","            },\n","            \"properties\": {\n","                \"Estado\": row['Estado']\n","            }\n","        }\n","        for _, row in df.iterrows()\n","    ]\n","}\n","\n","with open('puntos_activos.geojson', 'w', encoding='utf-8') as f:\n","    json.dump(geojson, f, ensure_ascii=False, indent=2)\n","\n","print(f\"✅ GeoJSON guardado: 'puntos_activos.geojson' con {len(geojson['features'])} puntos\")\n","\n","# === 5. GUARDAR TAMBIÉN COMO CSV ===\n","df.to_csv('puntos_activos.csv', index=False, encoding='utf-8')\n","print(\"✅ CSV guardado: 'puntos_activos.csv'\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"gfkEg7__MQNh","executionInfo":{"status":"ok","timestamp":1790165929468,"user_tz":180,"elapsed":50,"user":{"displayName":"Santiago Rodriguez","userId":"13982403190253310554"}},"outputId":"e79e0415-e202-4db2-8881-1dcfcc465bcf"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["✅ JSON cargado correctamente\n","✅ Se extrajeron 242 puntos\n","   Estado   Longitud    Latitud\n","0  Activo -65.265200 -26.857076\n","1  Activo -65.263685 -26.856020\n","2  Activo -65.263360 -26.856522\n","3  Activo -65.262215 -26.831483\n","4  Activo -65.261860 -26.868580\n","     Estado   Longitud    Latitud\n","237  Activo -65.169707 -26.829562\n","238  Activo -65.166915 -26.823498\n","239  Activo -65.164457 -26.816892\n","240  Activo -65.163007 -26.800700\n","241  Activo -65.161222 -26.814925\n","⚠️  Se esperaban 243 puntos, se obtuvieron 242\n","✅ GeoJSON guardado: 'puntos_activos.geojson' con 242 puntos\n","✅ CSV guardado: 'puntos_activos.csv'\n"]}]},{"cell_type":"code","source":["import json\n","\n","with open('datos_powerbi.json', 'r', encoding='utf-8-sig') as f:\n","    contenido = f.read()\n","\n","if not contenido.lstrip().startswith('{'):\n","    contenido = '{' + contenido\n","\n","data = json.loads(contenido)\n","\n","# Contar TODOS los bloques \"C\" (incluso los que tienen null)\n","todos_los_C = []\n","C_con_nulos = []\n","\n","def buscar_todos(nodo):\n","    if isinstance(nodo, dict):\n","        if 'C' in nodo and isinstance(nodo['C'], list):\n","            todos_los_C.append(nodo['C'])\n","            # Verificar si tiene nulos\n","            if any(v is None for v in nodo['C']):\n","                C_con_nulos.append(nodo['C'])\n","        for v in nodo.values():\n","            buscar_todos(v)\n","    elif isinstance(nodo, list):\n","        for item in nodo:\n","            buscar_todos(item)\n","\n","buscar_todos(data)\n","\n","print(f\"📊 Total de bloques 'C' encontrados: {len(todos_los_C)}\")\n","print(f\"⚠️  Bloques 'C' con valores nulos: {len(C_con_nulos)}\")\n","\n","if C_con_nulos:\n","    print(\"\\n🔍 Puntos con nulos (estos son los que se descartan):\")\n","    for i, c in enumerate(C_con_nulos):\n","        print(f\"  {i+1}: {c}\")\n","\n","# Contar bloques con longitud 2 (los válidos)\n","C_validos = [c for c in todos_los_C if len(c) == 2 and all(v is not None for v in c)]\n","print(f\"\\n✅ Puntos válidos con coordenadas completas: {len(C_validos)}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"JqSF0Q4MMS8Q","executionInfo":{"status":"ok","timestamp":1790166076148,"user_tz":180,"elapsed":29,"user":{"displayName":"Santiago Rodriguez","userId":"13982403190253310554"}},"outputId":"722ea5f2-190a-4611-bfa9-8b269640e5bf"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["📊 Total de bloques 'C' encontrados: 242\n","⚠️  Bloques 'C' con valores nulos: 0\n","\n","✅ Puntos válidos con coordenadas completas: 242\n"]}]},{"cell_type":"code","source":["import os\n","os.rename('puntos_activos.geojson', 'basurales_activos.geojson')\n","os.rename('puntos_activos.csv', 'basurales_activos.csv')\n","print(\"✅ Archivos renombrados\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"wzHy-J7KOOT_","executionInfo":{"status":"ok","timestamp":1790166243837,"user_tz":180,"elapsed":91,"user":{"displayName":"Santiago Rodriguez","userId":"13982403190253310554"}},"outputId":"93e61ca6-24ee-4236-aef4-a6a1f974eb9b"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["✅ Archivos renombrados\n"]}]},{"cell_type":"markdown","source":["# 1. Proceso para Validar y obtener datos del municipio"],"metadata":{"id":"X_KNiCtxQ6O5"}},{"cell_type":"code","source":["!pip install geopandas -q"],"metadata":{"id":"JY6BXru0RP_9","executionInfo":{"status":"ok","timestamp":1790167077294,"user_tz":180,"elapsed":8498,"user":{"displayName":"Santiago Rodriguez","userId":"13982403190253310554"}}},"execution_count":8,"outputs":[]},{"cell_type":"code","source":["from pathlib import Path\n","\n","CARPETA = Path('/content')  # En Colab los archivos subidos van aquí\n","ARCHIVO_BASURALES = CARPETA / 'basurales_activos.geojson'\n","ARCHIVO_MUNICIPIO = CARPETA / 'limites_municipio.geojson'\n","ARCHIVO_DISTRITOS = CARPETA / 'limites_distritos.geojson'\n","ARCHIVO_BARRIOS   = CARPETA / 'limites_barrios.geojson'"],"metadata":{"id":"cXaMGiCqRk0q","executionInfo":{"status":"ok","timestamp":1790167121348,"user_tz":180,"elapsed":10,"user":{"displayName":"Santiago Rodriguez","userId":"13982403190253310554"}}},"execution_count":9,"outputs":[]},{"cell_type":"code","source":["# === CELDA 3: Script de análisis ===\n","import geopandas as gpd\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import numpy as np\n","from pathlib import Path\n","from IPython.display import Image, display\n","\n","CARPETA = Path('/content')\n","ARCHIVO_BASURALES = CARPETA / 'basurales_activos.geojson'\n","ARCHIVO_MUNICIPIO = CARPETA / 'limite_smt_final.geojson'\n","ARCHIVO_DISTRITOS = CARPETA / 'distritos.geojson'\n","ARCHIVO_BARRIOS   = CARPETA / 'barrios.geojson'\n","\n","# === 1. CARGAR CAPAS ===\n","print(\"📂 Cargando capas...\")\n","basurales = gpd.read_file(ARCHIVO_BASURALES)\n","municipio = gpd.read_file(ARCHIVO_MUNICIPIO)\n","distritos = gpd.read_file(ARCHIVO_DISTRITOS)\n","barrios   = gpd.read_file(ARCHIVO_BARRIOS)\n","\n","print(f\"  Basurales: {len(basurales)} puntos\")\n","print(f\"  Distritos: {len(distritos)} polígonos\")\n","print(f\"  Barrios: {len(barrios)} polígonos\")\n","\n","# === 2. VERIFICAR CRS ===\n","print(\"\\n🌐 CRS:\")\n","print(f\"  Basurales: {basurales.crs}\")\n","print(f\"  Distritos: {distritos.crs}\")\n","print(f\"  Barrios: {barrios.crs}\")\n","\n","# Reproyectar todo a EPSG:4326 (WGS84)\n","for nombre, gdf in [('basurales', basurales), ('distritos', distritos),\n","                    ('barrios', barrios), ('municipio', municipio)]:\n","    if gdf.crs is None:\n","        print(f\"  ⚠️  {nombre} no tiene CRS definido, asumiendo EPSG:4326\")\n","        gdf.set_crs(\"EPSG:4326\", inplace=True)\n","\n","basurales = basurales.to_crs(\"EPSG:4326\")\n","distritos = distritos.to_crs(\"EPSG:4326\")\n","barrios   = barrios.to_crs(\"EPSG:4326\")\n","municipio = municipio.to_crs(\"EPSG:4326\")\n","\n","# === 3. DETECTAR COLUMNAS DE NOMBRE ===\n","def detectar_columna_nombre(gdf, candidatos=None):\n","    if candidatos is None:\n","        candidatos = ['nombre', 'NOMBRE', 'Name', 'name', 'BARRIO', 'barrio',\n","                      'DISTRITO', 'distrito', 'NOM_DIST', 'NOM_BARRIO',\n","                      'NOMBRE_BARRIO', 'NOMBRE_DISTRITO', 'nom_distrito',\n","                      'nom_barrio', 'NOM', 'nom']\n","    for col in candidatos:\n","        if col in gdf.columns:\n","            return col\n","    for col in gdf.columns:\n","        if gdf[col].dtype == 'object' and col != 'geometry':\n","            return col\n","    return gdf.columns[0]\n","\n","col_distrito = detectar_columna_nombre(distritos)\n","col_barrio   = detectar_columna_nombre(barrios)\n","print(f\"\\n🔑 Columna distritos: '{col_distrito}'\")\n","print(f\"🔑 Columna barrios: '{col_barrio}'\")\n","\n","# === 4. SPATIAL JOIN ===\n","print(\"\\n🔗 Asignando distrito y barrio...\")\n","\n","# Primer join: distritos\n","basurales_dist = gpd.sjoin(\n","    basurales, distritos[[col_distrito, 'geometry']],\n","    how='left', predicate='within'\n",").rename(columns={col_distrito: 'Distrito'})\n","\n","# ⚠️ IMPORTANTE: eliminar index_right antes del segundo join\n","basurales_dist = basurales_dist.drop(\n","    columns=[c for c in basurales_dist.columns if c.startswith('index_right')],\n","    errors='ignore'\n",")\n","\n","# Segundo join: barrios\n","basurales_todo = gpd.sjoin(\n","    basurales_dist, barrios[[col_barrio, 'geometry']],\n","    how='left', predicate='within'\n",").rename(columns={col_barrio: 'Barrio'})\n","\n","# Limpiar de nuevo por si quedó algo\n","basurales_todo = basurales_todo.drop(\n","    columns=[c for c in basurales_todo.columns if c.startswith('index_right')],\n","    errors='ignore'\n",")\n","\n","print(f\"  ✅ {len(basurales_todo)} basurales procesados\")\n","print(f\"  ⚠️  Sin distrito: {basurales_todo['Distrito'].isna().sum()}\")\n","print(f\"  ⚠️  Sin barrio: {basurales_todo['Barrio'].isna().sum()}\")\n","\n","basurales_todo.drop(columns='geometry').to_csv(\n","    'basurales_con_distrito_y_barrio.csv', index=False, encoding='utf-8')\n","\n","# === 5. CONTEOS ===\n","conteo_distritos = basurales_todo.groupby('Distrito').size().reset_index(name='cantidad_basurales')\n","conteo_barrios   = basurales_todo.groupby('Barrio').size().reset_index(name='cantidad_basurales')\n","\n","conteo_distritos = conteo_distritos.sort_values('cantidad_basurales', ascending=False)\n","conteo_barrios   = conteo_barrios.sort_values('cantidad_basurales', ascending=False)\n","\n","print(\"\\n📊 TOP 10 distritos:\")\n","print(conteo_distritos.head(10).to_string(index=False))\n","print(\"\\n📊 TOP 10 barrios:\")\n","print(conteo_barrios.head(10).to_string(index=False))\n","\n","conteo_distritos.to_csv('conteo_por_distrito.csv', index=False, encoding='utf-8')\n","conteo_barrios.to_csv('conteo_por_barrio.csv', index=False, encoding='utf-8')\n","\n","# === 6. UNIR CONTEOS A POLÍGONOS ===\n","distritos_mapa = distritos.merge(\n","    conteo_distritos, left_on=col_distrito, right_on='Distrito', how='left')\n","distritos_mapa['cantidad_basurales'] = distritos_mapa['cantidad_basurales'].fillna(0)\n","\n","barrios_mapa = barrios.merge(\n","    conteo_barrios, left_on=col_barrio, right_on='Barrio', how='left')\n","barrios_mapa['cantidad_basurales'] = barrios_mapa['cantidad_basurales'].fillna(0)\n","\n","# === 7. MAPAS DE CALOR ===\n","def generar_mapa_calor(gdf, col_nombre, titulo, archivo, cmap='YlOrRd', figsize=(14, 12)):\n","    fig, ax = plt.subplots(1, 1, figsize=figsize)\n","    vmax = max(gdf['cantidad_basurales'].max(), 1)\n","\n","    gdf.plot(column='cantidad_basurales', cmap=cmap, linewidth=0.5,\n","             ax=ax, edgecolor='gray', legend=True,\n","             legend_kwds={'label': 'Cantidad de basurales', 'shrink': 0.6},\n","             vmin=0, vmax=vmax)\n","\n","    for _, row in gdf.iterrows():\n","        if row['cantidad_basurales'] > 0:\n","            p = row['geometry'].representative_point()\n","            ax.annotate(f\"{row[col_nombre]}\\n({int(row['cantidad_basurales'])})\",\n","                        xy=(p.x, p.y), ha='center', va='center',\n","                        fontsize=7, fontweight='bold',\n","                        bbox=dict(boxstyle='round,pad=0.2',\n","                                  facecolor='white', edgecolor='none', alpha=0.7))\n","\n","    ax.set_title(titulo, fontsize=16, fontweight='bold', pad=15)\n","    ax.set_axis_off()\n","    plt.tight_layout()\n","    plt.savefig(archivo, dpi=200, bbox_inches='tight')\n","    plt.close()\n","    print(f\"  🗺️  {archivo}\")\n","\n","print(\"\\n🎨 Generando mapas...\")\n","generar_mapa_calor(distritos_mapa, col_distrito,\n","                   'Basurales activos por distrito - San Miguel de Tucumán',\n","                   'mapa_calor_distritos.png')\n","generar_mapa_calor(barrios_mapa, col_barrio,\n","                   'Basurales activos por barrio - San Miguel de Tucumán',\n","                   'mapa_calor_barrios.png', figsize=(16, 14))\n","\n","# Mapa combinado\n","fig, ax = plt.subplots(1, 1, figsize=(14, 14))\n","municipio.plot(ax=ax, facecolor='none', edgecolor='black', linewidth=2)\n","distritos_mapa.plot(column='cantidad_basurales', cmap='YlOrRd',\n","                    linewidth=0.5, ax=ax, edgecolor='gray', alpha=0.7)\n","basurales.plot(ax=ax, color='red', markersize=8,\n","               edgecolor='black', linewidth=0.3, label='Basurales')\n","ax.set_title('Distribución de basurales - San Miguel de Tucumán',\n","             fontsize=16, fontweight='bold')\n","ax.set_axis_off()\n","ax.legend(loc='lower right')\n","plt.tight_layout()\n","plt.savefig('mapa_combinado.png', dpi=200, bbox_inches='tight')\n","plt.close()\n","print(\"  🗺️  mapa_combinado.png\")\n","\n","# === 8. EXPORTAR GEOJSONS ===\n","distritos_mapa.to_file('distritos_con_conteo.geojson', driver='GeoJSON')\n","barrios_mapa.to_file('barrios_con_conteo.geojson', driver='GeoJSON')\n","basurales_todo.to_file('basurales_con_distrito_y_barrio.geojson', driver='GeoJSON')\n","\n","# === 9. VISUALIZAR EN COLAB ===\n","print(\"\\n🖼️  Mostrando mapas:\")\n","display(Image('mapa_calor_distritos.png'))\n","display(Image('mapa_calor_barrios.png'))\n","display(Image('mapa_combinado.png'))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"output_embedded_package_id":"1LIK-rK82Oz7B3hTAGfzJfXPrxik_Upht"},"id":"JcCXRwN5R0fj","executionInfo":{"status":"ok","timestamp":1790167460008,"user_tz":180,"elapsed":6220,"user":{"displayName":"Santiago Rodriguez","userId":"13982403190253310554"}},"outputId":"7b7ed7ac-d5ab-4337-9439-a278773c1384"},"execution_count":12,"outputs":[{"output_type":"display_data","data":{"text/plain":"Output hidden; open in https://colab.research.google.com to view."},"metadata":{}}]}]}