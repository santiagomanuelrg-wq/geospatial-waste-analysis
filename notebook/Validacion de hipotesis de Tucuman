{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOtS4RGXbtWwL1MFOuhW5uF"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["# Codigo Para Validar Hipotesis de calles aisladas de Tucuman"],"metadata":{"id":"RKUxxMFKs6bj"}},{"cell_type":"markdown","source":["El siguiente codigo Tratara de reducir a un numero aislados de calles, la cantidad de basurales presentes de San Miguel de Tucuman."],"metadata":{"id":"L19jgfOrtEt8"}},{"cell_type":"code","source":["!pip install geopandas fiona shapely pyproj -q"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"nBEHL19uuJ6W","executionInfo":{"status":"ok","timestamp":1790376280499,"user_tz":180,"elapsed":9150,"user":{"displayName":"Santiago Rodriguez","userId":"13982403190253310554"}},"outputId":"6cc1ef73-d8b8-4c10-ac71-937ff8ebf615"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\u001b[2K     \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m56.6/56.6 kB\u001b[0m \u001b[31m2.5 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m17.2/17.2 MB\u001b[0m \u001b[31m77.2 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[?25h"]}]},{"cell_type":"code","source":["import os\n","from pathlib import Path\n","import fiona\n","import geopandas as gpd\n","import numpy as np\n","import pandas as pd\n","from shapely.geometry import LineString, MultiLineString, Point\n","\n","# Habilitar soporte para KML en el motor Fiona/GDAL\n","fiona.drvsupport.supported_drivers[\"KML\"] = \"rw\"\n","\n","\n","# ==============================================================================\n","# FUNCIONES AUXILIARES DE EXTRACCIÓN Y LIMPIEZA GEOMÉTRICA\n","# ==============================================================================\n","def extraer_geometrias_kml(\n","    kml_path: str, tipos_permitidos: list[str]\n",") -> gpd.GeoDataFrame:\n","    \"\"\"Inspecciona todas las capas de un KML y extrae las geometrías\n","\n","    correspondientes a los tipos especificados ('Point', 'LineString', etc.).\n","\n","    Qué hace -> Lee exhaustivamente el KML capa por capa.\n","    Por qué -> My Maps suele empaquetar carpetas/capas internas que gpd.read_file ignora por defecto.\n","    Qué problema evita -> Pérdida de datos por lectura incompleta del archivo.\n","    \"\"\"\n","    path = Path(kml_path)\n","    if not path.exists():\n","        raise FileNotFoundError(\n","            f\"No se encuentra el archivo en la ruta especificada: {path}\"\n","        )\n","\n","    gdfs = []\n","    capas = fiona.listlayers(str(path))\n","\n","    for capa in capas:\n","        try:\n","            gdf_capa = gpd.read_file(str(path), driver=\"KML\", layer=capa)\n","            if not gdf_capa.empty:\n","                gdfs.append(gdf_capa)\n","        except Exception as e:\n","            print(f\"Advertencia: No se pudo leer la capa '{capa}': {e}\")\n","\n","    if not gdfs:\n","        raise ValueError(\n","            f\"No se pudieron extraer datos válidos del KML: {kml_path}\"\n","        )\n","\n","    # Concatenar todas las capas del KML\n","    gdf_total = pd.concat(gdfs, ignore_index=True)\n","    gdf_total = gpd.GeoDataFrame(gdf_total, crs=\"EPSG:4326\")\n","\n","    # Filtrar estrictamente por tipo geométrico deseado\n","    gdf_filtrado = gdf_total[\n","        gdf_total.geometry.type.isin(tipos_permitidos)\n","    ].copy()\n","\n","    # Eliminar geometrías nulas o vacías\n","    gdf_filtrado = gdf_filtrado[~gdf_filtrado.geometry.is_empty].dropna(\n","        subset=[\"geometry\"]\n","    )\n","\n","    return gdf_filtrado\n","\n","\n","def consolidar_basurales(\n","    rutas_kml_puntos: list[str],\n",") -> gpd.GeoDataFrame:\n","    \"\"\"Extrae y consolida los puntos de basurales de múltiples KMLs,\n","\n","    eliminando duplicados espaciales exactos.\n","    \"\"\"\n","    lista_gdfs = []\n","    for ruta in rutas_kml_puntos:\n","        print(f\"-> Extrayendo puntos desde: {Path(ruta).name}\")\n","        gdf_p = extraer_geometrias_kml(\n","            ruta, tipos_permitidos=[\"Point\", \"MultiPoint\"]\n","        )\n","        lista_gdfs.append(gdf_p)\n","\n","    gdf_consolidado = pd.concat(lista_gdfs, ignore_index=True)\n","    gdf_consolidado = gpd.GeoDataFrame(gdf_consolidado, crs=\"EPSG:4326\")\n","\n","    # Deduplicación por coordenadas exactas (WGS84)\n","    total_inicial = len(gdf_consolidado)\n","    gdf_consolidado[\"wkt_geom\"] = gdf_consolidado.geometry.to_wkt()\n","    gdf_consolidado = gdf_consolidado.drop_duplicates(\n","        subset=[\"wkt_geom\"]\n","    ).drop(columns=[\"wkt_geom\"])\n","    total_deduplicado = len(gdf_consolidado)\n","\n","    print(f\"Total de registros leídos: {total_inicial}\")\n","    print(\n","        f\"Total tras eliminar duplicados exactos: {total_deduplicado} (Removidos: {total_inicial - total_deduplicado})\"\n","    )\n","\n","    return gdf_consolidado\n","\n","\n","# ==============================================================================\n","# PIPELINE PRINCIPAL DE ANÁLISIS ESPACIAL DE PROXIMIDAD\n","# ==============================================================================\n","def ejecutar_analisis_cobertura_basurales(\n","    kml_basurales_list: list[str],\n","    kml_lineas_list: list[str],\n","    buffer_evaluacion_m: float = 30.0,\n","    epsg_proyectado: int = 32720,  # POSGAR 2007 / UTM Zone 20S (Tucumán)\n",") -> tuple[gpd.GeoDataFrame, pd.DataFrame]:\n","\n","    print(\"==================================================\")\n","    print(\" 1. CARGA Y CONSOLIDACIÓN DE PUNTOS (BASURALES)\")\n","    print(\"==================================================\")\n","    gdf_puntos_wgs84 = consolidar_basurales(kml_basurales_list)\n","\n","    print(\"\\n==================================================\")\n","    print(\" 2. CARGA Y CONSOLIDACIÓN DE LÍNEAS (VIAS/CALLES)\")\n","    print(\"==================================================\")\n","    lista_gdfs_lineas = []\n","    for ruta in kml_lineas_list:\n","        print(f\"-> Extrayendo líneas desde: {Path(ruta).name}\")\n","        gdf_l = extraer_geometrias_kml(\n","            ruta, tipos_permitidos=[\"LineString\", \"MultiLineString\"]\n","        )\n","        lista_gdfs_lineas.append(gdf_l)\n","\n","    gdf_lineas_wgs84 = pd.concat(lista_gdfs_lineas, ignore_index=True)\n","    gdf_lineas_wgs84 = gpd.GeoDataFrame(gdf_lineas_wgs84, crs=\"EPSG:4326\")\n","    print(f\"Total de tramos lineales extraídos: {len(gdf_lineas_wgs84)}\")\n","\n","    print(\"\\n==================================================\")\n","    print(f\" 3. REPROYECCIÓN A CRS MÉTRICO (EPSG:{epsg_proyectado})\")\n","    print(\"==================================================\")\n","    gdf_puntos_m = gdf_puntos_wgs84.to_crs(epsg=epsg_proyectado)\n","    gdf_lineas_m = gdf_lineas_wgs84.to_crs(epsg=epsg_proyectado)\n","\n","    # Fusionar la red de líneas en una sola entidad geométrica (MultiLineString)\n","    # Permite calcular la distancia punto-red vectorialmente\n","    union_red_lineal = gdf_lineas_m.geometry.unary_union\n","\n","    print(\"\\n==================================================\")\n","    print(\" 4. CÁLCULO DE DISTANCIAS Y EVALUACIÓN DE HIPÓTESIS\")\n","    print(\"==================================================\")\n","    # Distancia mínima en metros de cada basural a la red lineal\n","    distancias_m = gdf_puntos_m.geometry.distance(union_red_lineal)\n","\n","    # Enriquecer GeoDataFrame\n","    gdf_puntos_m[\"dist_a_red_m\"] = distancias_m.round(2)\n","    gdf_puntos_m[f\"dentro_buffer_{int(buffer_evaluacion_m)}m\"] = (\n","        distancias_m <= buffer_evaluacion_m\n","    )\n","\n","    total_puntos = len(gdf_puntos_m)\n","    puntos_en_buffer = (distancias_m <= buffer_evaluacion_m).sum()\n","    porcentaje_cobertura = (puntos_en_buffer / total_puntos) * 100\n","\n","    print(f\"Resultados principales (Buffer = {buffer_evaluacion_m}m):\")\n","    print(f\" - Total de basurales analizados: {total_puntos}\")\n","    print(f\" - Basurales explicados por la red: {puntos_en_buffer}\")\n","    print(f\" - Porcentaje de cobertura: {porcentaje_cobertura:.2f}%\")\n","    print(\n","        f\" - ¿Se valida la hipótesis (>= 30%)?: {'SÍ' if porcentaje_cobertura >= 30.0 else 'NO'}\"\n","    )\n","\n","    # Matriz de Sensibilidad\n","    umbrales = [10.0, 20.0, 30.0, 40.0, 50.0, 100.0]\n","    metricas_sensibilidad = []\n","\n","    for u in umbrales:\n","        cant = (distancias_m <= u).sum()\n","        pct = (cant / total_puntos) * 100\n","        metricas_sensibilidad.append(\n","            {\n","                \"Umbral_Buffer_Metros\": u,\n","                \"Basurales_Dentro\": cant,\n","                \"Porcentaje_Acumulado\": round(pct, 2),\n","            }\n","        )\n","\n","    df_sensibilidad = pd.DataFrame(metricas_sensibilidad)\n","\n","    return gdf_puntos_m, df_sensibilidad\n","\n","\n","# ==============================================================================\n","# EJECUCIÓN EN GOOGLE COLAB\n","# ==============================================================================\n","if __name__ == \"__main__\":\n","    # Definición de rutas relativas según los archivos cargados en el root de Colab (/content/)\n","    # 1. Lista de KMLs con Puntos de Basurales\n","    ARCHIVOS_BASURALES = [\n","        \"basurales San miguel de Tucuman.kml\",\n","        \"basurales_activos.csv.kml\",\n","    ]\n","\n","    # 2. Lista de KMLs con Líneas (Calles/Vías)\n","    # Incluimos 'calles y vias aisladas.kml' y 'basurales San Miguel de Tucuman.kml'\n","    # para asegurar extraer líneas si existían en el primer archivo.\n","    ARCHIVOS_LINEAS = [\n","        \"calles y vias aisladas.kml\",\n","        \"basurales San miguel de Tucuman.kml\",\n","    ]\n","\n","    # Parámetros del análisis\n","    BUFFER_OBJETIVO = 30.0  # metros\n","    EPSG_TUCUMAN = 32720  # POSGAR 2007 / UTM zone 20S\n","\n","    # Ejecutar pipeline\n","    try:\n","        gdf_resultado, df_analisis_sensibilidad = (\n","            ejecutar_analisis_cobertura_basurales(\n","                kml_basurales_list=ARCHIVOS_BASURALES,\n","                kml_lineas_list=ARCHIVOS_LINEAS,\n","                buffer_evaluacion_m=BUFFER_OBJETIVO,\n","                epsg_proyectado=EPSG_TUCUMAN,\n","            )\n","        )\n","\n","        print(\"\\n==================================================\")\n","        print(\" ANÁLISIS DE SENSIBILIDAD DE DISTANCIA\")\n","        print(\"==================================================\")\n","        print(df_analisis_sensibilidad.to_string(index=False))\n","\n","        # Exportar resultado consolidado a GeoPackage para inspección en QGIS / SaaS LimpIAr\n","        OUTPUT_GPKG = \"basurales_analisis_proximidad.gpkg\"\n","        gdf_resultado.to_file(OUTPUT_GPKG, driver=\"GPKG\", layer=\"basurales_m\")\n","        print(\n","            f\"\\n[OK] Capa vectorial exportada correctamente a: {OUTPUT_GPKG}\"\n","        )\n","\n","    except Exception as err:\n","        print(f\"\\n[ERROR DE EJECUCIÓN]: {err}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ZEsqtmnjxiAp","executionInfo":{"status":"ok","timestamp":1790376297909,"user_tz":180,"elapsed":1688,"user":{"displayName":"Santiago Rodriguez","userId":"13982403190253310554"}},"outputId":"8077dc25-35d1-4576-f276-6d1a8aa549bb"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["==================================================\n"," 1. CARGA Y CONSOLIDACIÓN DE PUNTOS (BASURALES)\n","==================================================\n","-> Extrayendo puntos desde: basurales San miguel de Tucuman.kml\n","-> Extrayendo puntos desde: basurales_activos.csv.kml\n","Total de registros leídos: 484\n","Total tras eliminar duplicados exactos: 242 (Removidos: 242)\n","\n","==================================================\n"," 2. CARGA Y CONSOLIDACIÓN DE LÍNEAS (VIAS/CALLES)\n","==================================================\n","-> Extrayendo líneas desde: calles y vias aisladas.kml\n","-> Extrayendo líneas desde: basurales San miguel de Tucuman.kml\n","Total de tramos lineales extraídos: 18\n","\n","==================================================\n"," 3. REPROYECCIÓN A CRS MÉTRICO (EPSG:32720)\n","==================================================\n","\n","==================================================\n"," 4. CÁLCULO DE DISTANCIAS Y EVALUACIÓN DE HIPÓTESIS\n","==================================================\n","Resultados principales (Buffer = 30.0m):\n"," - Total de basurales analizados: 242\n"," - Basurales explicados por la red: 73\n"," - Porcentaje de cobertura: 30.17%\n"," - ¿Se valida la hipótesis (>= 30%)?: SÍ\n","\n","==================================================\n"," ANÁLISIS DE SENSIBILIDAD DE DISTANCIA\n","==================================================\n"," Umbral_Buffer_Metros  Basurales_Dentro  Porcentaje_Acumulado\n","                 10.0                55                 22.73\n","                 20.0                66                 27.27\n","                 30.0                73                 30.17\n","                 40.0                76                 31.40\n","                 50.0                80                 33.06\n","                100.0                95                 39.26\n","\n","[OK] Capa vectorial exportada correctamente a: basurales_analisis_proximidad.gpkg\n"]},{"output_type":"stream","name":"stderr","text":["/tmp/ipykernel_2254/2408543769.py:138: DeprecationWarning: The 'unary_union' attribute is deprecated, use the 'union_all()' method instead.\n","  union_red_lineal = gdf_lineas_m.geometry.unary_union\n"]}]},{"cell_type":"markdown","source":["Para priorizar el trabajo de campo y optimizar los vuelos de dron con la plataforma LimpIAr, necesitamos la distribución espacial por tramo/línea. No basta con saber qué porcentaje cubre toda la red; debemos saber cuántos basurales atrae cada línea individual, su densidad (basurales por kilómetro) y su contribución relativa."],"metadata":{"id":"VaPOz7MD1dTL"}},{"cell_type":"markdown","source":["Para responder a esto sin caer en ambigüedades topológicas cuando los buffers de líneas contiguas se superponen, implementaremos un Análisis de Asignación por Proximidad Mínima (Nearest Neighbor Spatial Join):\n","1. Unicidad en Líneas: Identificaremos cada tramo de línea individualmente (asignando un ID único y extrayendo su atributo Name o Description proveniente del KML).\n","2. Asignación Mínima (Punto -> Línea Más Cercana): Para cada uno de los $242$ basurales, calcularemos la distancia a todas las líneas individuales de la red y lo asignaremos a la línea cuya distancia sea estrictamente la menor ($d_{\\min}$).\n","3. Filtrado por Umbral de Buffer ($30\\text{ m}$): Un basural sumará al conteo de una línea solo si $d_{\\min} \\le 30\\text{ m}$. Esto evita contar dos veces un basural si se encuentra en la intersección de dos tramos.\n","4. Métricas de Priorización Operativa:Frecuencia Absoluta ($N_i$): Cantidad de basurales a $\\le 30\\text{ m}$ del tramo $i$.\n","Aporte Relativo ($\\%_{total}$): Porcentaje del total de basurales del municipio ($242$) que resuelve esa línea.\n","Aporte sobre Explicados ($\\%_{buffer}$): Porcentaje sobre el subconjunto de $69$ basurales.\n","Longitud del Tramo ($L_i$ en km): Calculada en CRS métrico (EPSG:32720).\n","Densidad Lineal de Basurales ($D_i = \\frac{N_i}{L_i}$ en basurales/km): Esta es la métrica clave para priorizar vuelos de dron en LimpIAr: una línea corta con muchos basurales tiene una densidad alta y representa un hotspot crítico de intervención."],"metadata":{"id":"6l94pVdq1mLA"}},{"cell_type":"code","source":["import os\n","from pathlib import Path\n","import re\n","import fiona\n","import geopandas as gpd\n","import numpy as np\n","import pandas as pd\n","\n","# Habilitar soporte KML en el motor Fiona\n","fiona.drvsupport.supported_drivers[\"KML\"] = \"rw\"\n","\n","\n","# ==============================================================================\n","# RESOLUCIÓN DINÁMICA DE RUTAS (CASE-INSENSITIVE)\n","# ==============================================================================\n","def resolver_ruta_archivo(nombre_buscado: str, directorio: str = \".\") -> Path:\n","    \"\"\"Busca un archivo en el directorio especificado ignorando diferencias\n","\n","    de mayúsculas, minúsculas o espacios múltiples.\n","\n","    Qué hace -> Escanea el directorio y compara nombres normalizados.\n","    Por qué -> Linux en Colab es case-sensitive y un fallo en una mayúscula rompe el pipeline.\n","    Qué problema evita -> FileNotFoundError por errores tipográficos menores.\n","    \"\"\"\n","    path_directo = Path(directorio) / nombre_buscado\n","    if path_directo.exists():\n","        return path_directo\n","\n","    # Normalizar nombre buscado (minusculas y espacios limpios)\n","    target_clean = re.sub(r\"\\s+\", \" \", nombre_buscado.strip().lower())\n","\n","    for item in Path(directorio).iterdir():\n","        if item.is_file():\n","            item_clean = re.sub(r\"\\s+\", \" \", item.name.strip().lower())\n","            if item_clean == target_clean:\n","                print(\n","                    f\" [Auto-Fix] Archivo resuelto: '{nombre_buscado}' -> '{item.name}'\"\n","                )\n","                return item\n","\n","    # Si no se encuentra, listar archivos disponibles para diagnóstico\n","    archivos_disponibles = [p.name for p in Path(directorio).glob(\"*.kml\")]\n","    raise FileNotFoundError(\n","        f\"No se encontró '{nombre_buscado}' en '{directorio}'. \"\n","        f\"Archivos .kml disponibles en el entorno: {archivos_disponibles}\"\n","    )\n","\n","\n","# ==============================================================================\n","# FUNCIONES AUXILIARES DE LECTURA Y CONSOLIDACIÓN KML\n","# ==============================================================================\n","def extraer_geometrias_kml(\n","    kml_path_str: str, tipos_permitidos: list[str]\n",") -> gpd.GeoDataFrame:\n","    \"\"\"Inspecciona todas las capas de un KML y extrae las geometrías indicadas.\"\"\"\n","    path = resolver_ruta_archivo(kml_path_str)\n","\n","    gdfs = []\n","    capas = fiona.listlayers(str(path))\n","\n","    for capa in capas:\n","        try:\n","            gdf_capa = gpd.read_file(str(path), driver=\"KML\", layer=capa)\n","            if not gdf_capa.empty:\n","                gdfs.append(gdf_capa)\n","        except Exception as e:\n","            print(\n","                f\"Advertencia: No se pudo leer la capa '{capa}' en {path.name}: {e}\"\n","            )\n","\n","    if not gdfs:\n","        raise ValueError(\n","            f\"No se pudieron extraer geometrías de {path.name}. Revisa el archivo.\"\n","        )\n","\n","    gdf_total = pd.concat(gdfs, ignore_index=True)\n","    gdf_total = gpd.GeoDataFrame(gdf_total, crs=\"EPSG:4326\")\n","\n","    # Filtrar por tipo geométrico deseado\n","    gdf_filtrado = gdf_total[\n","        gdf_total.geometry.type.isin(tipos_permitidos)\n","    ].copy()\n","    gdf_filtrado = gdf_filtrado[~gdf_filtrado.geometry.is_empty].dropna(\n","        subset=[\"geometry\"]\n","    )\n","\n","    return gdf_filtrado\n","\n","\n","def consolidar_basurales(rutas_kml_puntos: list[str]) -> gpd.GeoDataFrame:\n","    \"\"\"Extrae y consolida los puntos de basurales de múltiples KMLs,\n","\n","    eliminando duplicados espaciales exactos.\n","    \"\"\"\n","    lista_gdfs = []\n","    for ruta in rutas_kml_puntos:\n","        print(f\" -> Extrayendo puntos desde: {ruta}\")\n","        gdf_p = extraer_geometrias_kml(\n","            ruta, tipos_permitidos=[\"Point\", \"MultiPoint\"]\n","        )\n","        lista_gdfs.append(gdf_p)\n","\n","    gdf_consolidado = pd.concat(lista_gdfs, ignore_index=True)\n","    gdf_consolidado = gpd.GeoDataFrame(gdf_consolidado, crs=\"EPSG:4326\")\n","\n","    # Deduplicar por representación WKT\n","    total_inicial = len(gdf_consolidado)\n","    gdf_consolidado[\"wkt_geom\"] = gdf_consolidado.geometry.to_wkt()\n","    gdf_consolidado = gdf_consolidado.drop_duplicates(\n","        subset=[\"wkt_geom\"]\n","    ).drop(columns=[\"wkt_geom\"])\n","    total_deduplicado = len(gdf_consolidado)\n","\n","    print(\n","        f\" Total registros leídos: {total_inicial} | Puntos únicos: {total_deduplicado} (Removidos: {total_inicial - total_deduplicado})\"\n","    )\n","    return gdf_consolidado\n","\n","\n","# ==============================================================================\n","# PIPELINE PRINCIPAL DE PRIORIZACIÓN DE LÍNEAS\n","# ==============================================================================\n","def priorizar_lineas_trabajo_campo(\n","    kml_basurales_list: list[str],\n","    kml_lineas_list: list[str],\n","    buffer_evaluacion_m: float = 30.0,\n","    epsg_proyectado: int = 32720,  # POSGAR 2007 / UTM Zone 20S (Tucumán)\n",") -> tuple[pd.DataFrame, gpd.GeoDataFrame, gpd.GeoDataFrame]:\n","\n","    print(\"==================================================\")\n","    print(\" 1. CARGA Y CONSOLIDACIÓN DE GEOMETRÍAS\")\n","    print(\"==================================================\")\n","    gdf_puntos_wgs84 = consolidar_basurales(kml_basurales_list)\n","\n","    lista_gdfs_lineas = []\n","    for ruta in kml_lineas_list:\n","        print(f\" -> Extrayendo líneas desde: {ruta}\")\n","        gdf_l = extraer_geometrias_kml(\n","            ruta, tipos_permitidos=[\"LineString\", \"MultiLineString\"]\n","        )\n","        lista_gdfs_lineas.append(gdf_l)\n","\n","    gdf_lineas_wgs84 = pd.concat(lista_gdfs_lineas, ignore_index=True)\n","    gdf_lineas_wgs84 = gpd.GeoDataFrame(gdf_lineas_wgs84, crs=\"EPSG:4326\")\n","\n","    # Deduplicar tramos de línea idénticos\n","    gdf_lineas_wgs84[\"wkt_geom\"] = gdf_lineas_wgs84.geometry.to_wkt()\n","    gdf_lineas_wgs84 = gdf_lineas_wgs84.drop_duplicates(\n","        subset=[\"wkt_geom\"]\n","    ).drop(columns=[\"wkt_geom\"])\n","\n","    print(\"\\n==================================================\")\n","    print(f\" 2. REPROYECCIÓN MÉTRICA (EPSG:{epsg_proyectado}) Y ASIGNACIÓN\")\n","    print(\"==================================================\")\n","    gdf_puntos_m = gdf_puntos_wgs84.to_crs(epsg=epsg_proyectado)\n","    gdf_lineas_m = gdf_lineas_wgs84.to_crs(epsg=epsg_proyectado)\n","\n","    # Nombres e identificadores\n","    gdf_lineas_m[\"linea_id\"] = [\n","        f\"LINEA_{i+1:02d}\" for i in range(len(gdf_lineas_m))\n","    ]\n","    if \"Name\" in gdf_lineas_m.columns:\n","        gdf_lineas_m[\"nombre_linea\"] = (\n","            gdf_lineas_m[\"Name\"].fillna(\"Sin Nombre\").astype(str)\n","        )\n","    else:\n","        gdf_lineas_m[\"nombre_linea\"] = \"Tramo sin identificar\"\n","\n","    gdf_lineas_m[\"longitud_km\"] = (\n","        gdf_lineas_m.geometry.length / 1000.0\n","    ).round(3)\n","\n","    print(\n","        f\"Analizando {len(gdf_puntos_m)} basurales contra {len(gdf_lineas_m)} tramos lineales...\"\n","    )\n","\n","    # Matriz de distancias vectorizada (Punto -> Líneas)\n","    matriz_distancias = np.zeros((len(gdf_puntos_m), len(gdf_lineas_m)))\n","    for idx_linea, geom_linea in enumerate(gdf_lineas_m.geometry):\n","        matriz_distancias[:, idx_linea] = gdf_puntos_m.geometry.distance(\n","            geom_linea\n","        )\n","\n","    # Asignación por vecino más cercano\n","    idx_linea_cercana = np.argmin(matriz_distancias, axis=1)\n","    distancia_minima_m = np.min(matriz_distancias, axis=1)\n","\n","    gdf_puntos_m[\"linea_mas_cercana_id\"] = gdf_lineas_m[\"linea_id\"].iloc[\n","        idx_linea_cercana\n","    ].values\n","    gdf_puntos_m[\"nombre_linea_cercana\"] = gdf_lineas_m[\"nombre_linea\"].iloc[\n","        idx_linea_cercana\n","    ].values\n","    gdf_puntos_m[\"dist_a_linea_m\"] = np.round(distancia_minima_m, 2)\n","    gdf_puntos_m[\"en_buffer_30m\"] = distancia_minima_m <= buffer_evaluacion_m\n","\n","    print(\"\\n==================================================\")\n","    print(\" 3. AGREGACIÓN DE MÉTRICAS Y PRIORIZACIÓN\")\n","    print(\"==================================================\")\n","    total_basurales = len(gdf_puntos_m)\n","    puntos_validos = gdf_puntos_m[gdf_puntos_m[\"en_buffer_30m\"]]\n","\n","    conteo_por_linea = (\n","        puntos_validos.groupby(\"linea_mas_cercana_id\")\n","        .size()\n","        .reset_index(name=\"basurales_en_buffer\")\n","    )\n","\n","    df_ranking = gdf_lineas_m[\n","        [\"linea_id\", \"nombre_linea\", \"longitud_km\", \"geometry\"]\n","    ].merge(\n","        conteo_por_linea,\n","        left_on=\"linea_id\",\n","        right_on=\"linea_mas_cercana_id\",\n","        how=\"left\",\n","    )\n","\n","    df_ranking[\"basurales_en_buffer\"] = (\n","        df_ranking[\"basurales_en_buffer\"].fillna(0).astype(int)\n","    )\n","\n","    # Métricas de porcentaje y densidad\n","    df_ranking[\"pct_sobre_total_basurales\"] = np.round(\n","        (df_ranking[\"basurales_en_buffer\"] / total_basurales) * 100, 2\n","    )\n","\n","    total_explicados = df_ranking[\"basurales_en_buffer\"].sum()\n","    df_ranking[\"pct_sobre_basurales_explicados\"] = np.round(\n","        (\n","            df_ranking[\"basurales_en_buffer\"]\n","            / (total_explicados if total_explicados > 0 else 1)\n","        )\n","        * 100,\n","        2,\n","    )\n","\n","    df_ranking[\"densidad_basurales_per_km\"] = np.where(\n","        df_ranking[\"longitud_km\"] > 0,\n","        np.round(\n","            df_ranking[\"basurales_en_buffer\"] / df_ranking[\"longitud_km\"], 2\n","        ),\n","        0.0,\n","    )\n","\n","    # Lógica de priorización para gestión B2G/LimpIAr\n","    conditions = [\n","        (df_ranking[\"basurales_en_buffer\"] >= 10)\n","        | (df_ranking[\"densidad_basurales_per_km\"] >= 15.0),\n","        (df_ranking[\"basurales_en_buffer\"] >= 4)\n","        | (df_ranking[\"densidad_basurales_per_km\"] >= 5.0),\n","        (df_ranking[\"basurales_en_buffer\"] > 0),\n","    ]\n","    choices = [\n","        \"ALTA (Prioridad 1)\",\n","        \"MEDIA (Prioridad 2)\",\n","        \"BAJA (Prioridad 3)\",\n","    ]\n","    df_ranking[\"nivel_prioridad\"] = np.select(\n","        conditions, choices, default=\"NULA (Sin basurales)\"\n","    )\n","\n","    df_ranking = df_ranking.sort_values(\n","        by=[\"basurales_en_buffer\", \"densidad_basurales_per_km\"],\n","        ascending=False,\n","    ).reset_index(drop=True)\n","\n","    df_reporte = pd.DataFrame(df_ranking.drop(columns=[\"geometry\"]))\n","\n","    return (\n","        df_reporte,\n","        gdf_puntos_m,\n","        gpd.GeoDataFrame(df_ranking, crs=epsg_proyectado),\n","    )\n","\n","\n","# ==============================================================================\n","# EJECUCIÓN\n","# ==============================================================================\n","if __name__ == \"__main__\":\n","    # Nombres referenciales (la función resuelve automáticamente diferencias de mayúsculas/minúsculas)\n","    ARCHIVOS_BASURALES = [\n","        \"basurales San miguel de Tucuman.kml\",\n","        \"basurales_activos.csv.kml\",\n","    ]\n","\n","    ARCHIVOS_LINEAS = [\n","        \"calles y vias aisladas.kml\",\n","        \"basurales San miguel de Tucuman.kml\",\n","    ]\n","\n","    BUFFER_EVALUACION = 30.0  # metros\n","    EPSG_TUCUMAN = 32720  # POSGAR 2007 / UTM Zone 20S\n","\n","    try:\n","        df_prioridades, gdf_puntos_clasificados, gdf_lineas_priorizadas = (\n","            priorizar_lineas_trabajo_campo(\n","                kml_basurales_list=ARCHIVOS_BASURALES,\n","                kml_lineas_list=ARCHIVOS_LINEAS,\n","                buffer_evaluacion_m=BUFFER_EVALUACION,\n","                epsg_proyectado=EPSG_TUCUMAN,\n","            )\n","        )\n","\n","        print(\n","            \"\\n================================================================================\"\n","        )\n","        print(\n","            \" RANKING DE PRIORIZACIÓN DE LÍNEAS PARA TRABAJO DE CAMPO / DRON (LimpIAr)\"\n","        )\n","        print(\n","            \"================================================================================\"\n","        )\n","        cols_imprimir = [\n","            \"linea_id\",\n","            \"nombre_linea\",\n","            \"longitud_km\",\n","            \"basurales_en_buffer\",\n","            \"pct_sobre_total_basurales\",\n","            \"densidad_basurales_per_km\",\n","            \"nivel_prioridad\",\n","        ]\n","        print(df_prioridades[cols_imprimir].to_string(index=False))\n","\n","        # Exportación de GeoPackages para QGIS\n","        gdf_puntos_clasificados.to_file(\n","            \"basurales_clasificados_por_linea.gpkg\", driver=\"GPKG\"\n","        )\n","        gdf_lineas_priorizadas.to_file(\n","            \"lineas_priorizadas_campo.gpkg\", driver=\"GPKG\"\n","        )\n","\n","        print(\"\\n[OK] Capas exportadas a la sesión de Colab:\")\n","        print(\n","            \" - 'lineas_priorizadas_campo.gpkg' (Ranking lineal con densidad/km)\"\n","        )\n","        print(\" - 'basurales_clasificados_por_linea.gpkg' (Puntos asignados)\")\n","\n","    except Exception as e:\n","        print(f\"\\n[ERROR EN PIPELINE]: {e}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"i-DNoXxZ3klj","executionInfo":{"status":"ok","timestamp":1790376329566,"user_tz":180,"elapsed":322,"user":{"displayName":"Santiago Rodriguez","userId":"13982403190253310554"}},"outputId":"62ed3a6d-6ab8-440f-d4e5-4bf37c99796e"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["=====================================